  C -- 否 --> E["02 首次建档 · 读身份证 + 人脸"]
  D --> F["03 到达定位 · beacon"]
  E --> F
  F --> G["04 今日行程播报<br/>念一遍今天要做的三件事"]
  G --> H["05 取号排队"]
  H --> I["06 候诊<br/>前面还有 3 位"]
  I --> J["07 进诊室"]
  J --> K{通道}
  K -- 通用 --> K1[复述校验]
  K -- 视障 --> K2[全程代说 + 语音确认]
  K -- 听障 --> K3["替我说 · 把文字念给医生"]
  K1 --> L["08 检查规划<br/>抽血要空腹 / 心电图在二楼"]
  K2 --> L
  K3 --> L
  L --> M["09 执行与导航<br/>往前走十八步"]
  M --> N{还有没做的检查吗}
  N -- 有 --> M
  N -- 没有 --> O["10 缴费取药<br/>医保三宫格"]
  O --> P["11 小结与回家"]
  P --> Q[家属端推送]
  P --> R[归还 · 一键清空]
