%% 小暖 · 异常降级图（v1，2026-11-05 / T3）
%% 起点：T1 的 v0 骨架（同目录，六条判定齐全），T3 接管后补三处：
%%   ① 每个判断补「否 → 继续原步骤」，让六个菱形都是完整的是/否两条出路；
%%   ② 每条处理都补一个明确出口（回原步骤 / 求助键 / 归还清空），不留断头箭头；
%%   ③ 每条补一句人话兜底文案 —— 原文 03-交互流程.md 只写了动作没写字，
%%      这几句是 T3 起草的占位写法，文案归 T4，T4 定稿后以 T4 为准。
%% 口径来源：02-design/03-交互流程.md 第 3 节（六条异常）+ 02-design/02-信息架构.md 第 5 节（五状态清单）
%% 分组：①②④ 系统层（错在机器，出口回原步骤）｜③⑤ 伦理红线与硬件极限（出口一定是人）｜⑥ 收尾

flowchart TD
  S["任意步骤（11 节点中的任一节点）"] --> Q1{"① 网络断了"}
  S --> Q2{"② 语音识别置信度 &lt; 0.6"}
  S --> Q3{"③ 用户问题超出范围"}
  S --> Q4{"④ 长时间无操作 &gt; 90 秒"}
  S --> Q5{"⑤ 电量低于 15%"}
  S --> Q6{"⑥ 设备被归还但流程未完成"}

  Q1 -- "是" --> S1["离线可用：行程 / 导航 / 三宫格全部本地<br/>顶栏常驻「离线也能用」，不弹错误码<br/>小暖说：没连上网，我也能带您走"]
  Q2 -- "是" --> S2["不猜：两个候选放大并列（E1 屏），各带拼音，中间留 32px<br/>小暖说：我没听清，您说的是哪个？"]
  Q3 -- "是" --> S3["拒绝但给出路，绝不硬答<br/>把人工按钮顶到最前面<br/>小暖说：这个我不能答，我帮您叫护士"]
  Q4 -- "是" --> S4["不弹窗、不熄屏、不催，音量降一档<br/>人一动就恢复，不记次数<br/>小暖说：我在这，您慢慢来"]
  Q5 -- "是" --> S5["提前告知 + 引导回服务台换机<br/>押金与借用记录一并转移<br/>小暖说：快没电了，我陪您回服务台换一台"]
  Q6 -- "是" --> S6["收尾清单：没做完的事整理成待办推给家属端<br/>设备当场清空，不把半截任务留在机器里<br/>小暖说：这三件事还没做完，已经告诉您女儿"]

  Q1 -- "否" --> PASS["继续原步骤"]
  Q2 -- "否" --> PASS
  Q3 -- "否" --> PASS
  Q4 -- "否" --> PASS
  Q5 -- "否" --> PASS
  Q6 -- "否" --> PASS

  PASS --> R["回到原步骤继续"]
  S1 --> R
  S2 --> R
  S4 --> R
  S3 --> HELP["求助键长按 1.5 秒 · 人工接入"]
  S5 --> HELP
  S6 --> DONE["归还 · 一键清空"]

  classDef warn fill:#F8E9D6,stroke:#C9761F,stroke-width:2px
  classDef help fill:#F6DFDB,stroke:#B5392F,stroke-width:2px
  classDef ok fill:#DDEDE3,stroke:#2C7A52,stroke-width:2px
  class S1,S2,S4 warn
  class S3,S5,HELP help
  class S6,DONE,PASS ok
