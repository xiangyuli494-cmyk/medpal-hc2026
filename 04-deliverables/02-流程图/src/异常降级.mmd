%% v1.3（2026-11-08，排版优化）：按出口分组重排书写顺序（①②④→回原步骤｜③→求助｜
%%   ⑤⑥→归还清空），节点/箭头/文案零改动，仅减少自动布局的连线交叉。
%%   注：mermaid 自动排版无法做到 0 交叉，0 交叉是 A3 成品（手绘）的要求，不考核 .mmd。

flowchart TD
  S["任意步骤（11 节点中的任一节点）"] --> Q1{"① 网络断了"}
  S --> Q2{"② 语音识别置信度 &lt; 0.6"}
  S --> Q4{"④ 长时间无操作 &gt; 90 秒"}
  S --> Q3{"③ 用户问题超出范围"}
  S --> Q5{"⑤ 电量低于 15%"}
  S --> Q6{"⑥ 设备被归还但流程未完成"}

  Q1 -- "是" --> S1["离线可用：行程 / 导航 / 三宫格全部本地<br/>顶栏常驻「离线也能用」，不弹错误码<br/>小暖说：网断了，行程和导航还能用。"]
  Q2 -- "是" --> S2["不猜：两个候选放大并列（E1 屏），各带拼音，中间留 32px<br/>小暖说：我没听清，您说的是「心内」，还是「心衰」？"]
  Q4 -- "是" --> S4["不弹窗、不熄屏、不催，音量降一档<br/>人一动就恢复，不记次数<br/>小暖说：我在这，您慢慢来。"]
  Q3 -- "是" --> S3["拒绝但给出路，绝不硬答<br/>把人工按钮顶到最前面<br/>小暖说：这个我不能答。我帮您叫护士？"]
  Q5 -- "是" --> S5["提前告知 + 引导回服务台换机<br/>押金与借用记录一并转移<br/>小暖说：电快用完了，回服务台换一台，记录不会丢。"]
  Q6 -- "是" --> S6["收尾清单：没做完的事整理成待办推给家属端<br/>设备当场清空，不把半截任务留在机器里<br/>小暖说：还有 2 件没做完：抽血、取药。要把清单发给家里人吗？"]

  Q1 -- "否" --> PASS["继续原步骤"]
  Q2 -- "否" --> PASS
  Q4 -- "否" --> PASS
  Q3 -- "否" --> PASS
  Q5 -- "否" --> PASS
  Q6 -- "否" --> PASS

  PASS --> R["回到原步骤继续"]
  S1 --> R
  S2 --> R
  S4 --> R
  S3 --> HELP["求助键长按 1.5 秒 · 人工接入"]
  S5 --> DONE["归还 · 一键清空<br/>换机后新机从原节点接着走"]
  S6 --> DONE

  classDef warn fill:#F8E9D6,stroke:#C9761F,stroke-width:2px
  classDef help fill:#F6DFDB,stroke:#B5392F,stroke-width:2px
  classDef ok fill:#DDEDE3,stroke:#2C7A52,stroke-width:2px
  class S1,S2,S4,S5 warn
  class S3,HELP help
  class S6,DONE,PASS ok
